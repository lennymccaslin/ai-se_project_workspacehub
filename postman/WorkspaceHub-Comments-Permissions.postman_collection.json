{
  "info": {
    "name": "WorkspaceHub - Comment permissions",
    "description": "Checks that the Comments API enforces who may edit and delete a comment: the author, an owner or an admin may; any other member (or an unauthenticated / outside-organization caller) may not. Run against a freshly seeded database (npm run seed). Every deletion that is expected to succeed targets its own freshly created comment, so the folders can be run in order, and re-run, without 404s.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api" },
    { "key": "password", "value": "Password123!" },
    { "key": "ownerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "memberToken", "value": "" },
    { "key": "otherMemberToken", "value": "" },
    { "key": "outsiderToken", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "protectedCommentId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Login as owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('ownerToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"owner@workspacehub.dev\",\"password\":\"{{password}}\"}"
            }
          }
        },
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@workspacehub.dev\",\"password\":\"{{password}}\"}"
            }
          }
        },
        {
          "name": "Login as member (comment author)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('memberToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"member@workspacehub.dev\",\"password\":\"{{password}}\"}"
            }
          }
        },
        {
          "name": "Login as other member (not the author)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('otherMemberToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"other-member@workspacehub.dev\",\"password\":\"{{password}}\"}"
            }
          }
        },
        {
          "name": "Register outsider (owner of a different organization)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('outsiderEmail', `outsider-${suffix}@example.com`);",
                  "pm.collectionVariables.set('outsiderSlug', `outsider-${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('outsiderToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"Out\",\"lastName\":\"Sider\",\"email\":\"{{outsiderEmail}}\",\"password\":\"{{password}}\",\"organizationName\":\"Outsider Org\",\"organizationSlug\":\"{{outsiderSlug}}\"}"
            }
          }
        },
        {
          "name": "Pick a task to comment on",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tasks load', () => pm.response.to.have.status(200));",
                  "const tasks = pm.response.json().data;",
                  "pm.test('at least one task exists', () => pm.expect(tasks.length).to.be.above(0));",
                  "pm.collectionVariables.set('taskId', tasks[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": "{{baseUrl}}/tasks"
          }
        }
      ]
    },
    {
      "name": "1. Author may edit and delete their own comment",
      "item": [
        {
          "name": "Member creates a comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Author-owned comment\"}"
            }
          }
        },
        {
          "name": "Author edits own comment -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('content was updated', () => pm.expect(pm.response.json().data.content).to.eql('Edited by author'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Edited by author\"}"
            }
          }
        },
        {
          "name": "Author deletes own comment -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Deleted comment is gone -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "2. Admin may edit and delete any comment",
      "item": [
        {
          "name": "Member creates a comment for the admin to manage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Comment the admin will manage\"}"
            }
          }
        },
        {
          "name": "Admin edits someone else's comment -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('content was updated', () => pm.expect(pm.response.json().data.content).to.eql('Edited by admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Edited by admin\"}"
            }
          }
        },
        {
          "name": "Admin deletes someone else's comment -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "3. Owner may edit and delete any comment",
      "item": [
        {
          "name": "Member creates a comment for the owner to manage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Comment the owner will manage\"}"
            }
          }
        },
        {
          "name": "Owner edits someone else's comment -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('content was updated', () => pm.expect(pm.response.json().data.content).to.eql('Edited by owner'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Edited by owner\"}"
            }
          }
        },
        {
          "name": "Owner deletes someone else's comment -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "4. Everyone else is denied",
      "item": [
        {
          "name": "Member creates a protected comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('protectedCommentId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Original content\"}"
            }
          }
        },
        {
          "name": "Other member edits it -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherMemberToken}}"
              },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{protectedCommentId}}",
            "body": { "mode": "raw", "raw": "{\"content\":\"Hijacked\"}" }
          }
        },
        {
          "name": "Other member deletes it -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{otherMemberToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{protectedCommentId}}"
          }
        },
        {
          "name": "Request without a token edits it -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{protectedCommentId}}",
            "body": { "mode": "raw", "raw": "{\"content\":\"Anonymous edit\"}" }
          }
        },
        {
          "name": "User from another organization edits it -> denied (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('denied', () => pm.expect(pm.response.code).to.be.oneOf([403, 404]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{outsiderToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{protectedCommentId}}",
            "body": { "mode": "raw", "raw": "{\"content\":\"Cross-org edit\"}" }
          }
        },
        {
          "name": "User from another organization deletes it -> denied (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('denied', () => pm.expect(pm.response.code).to.be.oneOf([403, 404]));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{outsiderToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{protectedCommentId}}"
          }
        },
        {
          "name": "Comment is unchanged after all denied attempts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('content is untouched', () => pm.expect(pm.response.json().data.content).to.eql('Original content'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{protectedCommentId}}"
          }
        },
        {
          "name": "Admin creates a comment (privileged author)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Admin-authored comment\"}"
            }
          }
        },
        {
          "name": "Regular member edits the admin's comment -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Member overrides admin\"}"
            }
          }
        },
        {
          "name": "Regular member deletes the admin's comment -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "5. Cleanup",
      "item": [
        {
          "name": "Admin deletes the admin-authored comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Author deletes the protected comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{protectedCommentId}}"
          }
        }
      ]
    }
  ]
}
