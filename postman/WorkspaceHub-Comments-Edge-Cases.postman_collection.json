        {
          "name": "Patch with whitespace and forged ownership fields",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"  trimmed content  \",\"authorId\":\"000000000000000000000000\",\"organizationId\":\"000000000000000000000000\",\"taskId\":\"{{otherTaskId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Content is trimmed and ownership fields cannot be reassigned', () => { pm.response.to.have.status(200); const c = pm.response.json().data; pm.expect(c.content).to.eql('trimmed content'); pm.expect(c.authorId).to.eql(pm.collectionVariables.get('userId')); pm.expect(c.organizationId).to.eql(pm.collectionVariables.get('organizationId')); pm.expect(c.taskId).to.eql(pm.collectionVariables.get('taskId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create with forged ownership fields",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"  forged fields test  \",\"authorId\":\"000000000000000000000000\",\"organizationId\":\"000000000000000000000000\",\"taskId\":\"{{otherTaskId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server derives author, organization and task and trims content', () => { pm.response.to.have.status(201); const c = pm.response.json().data; pm.expect(c.content).to.eql('forged fields test'); pm.expect(c.authorId).to.eql(pm.collectionVariables.get('userId')); pm.expect(c.organizationId).to.eql(pm.collectionVariables.get('organizationId')); pm.expect(c.taskId).to.eql(pm.collectionVariables.get('taskId')); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('forgedCommentId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Clean up forged-fields comment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{forgedCommentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Temporary forged-fields comment is deleted', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.deleted).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete the control comment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}"
