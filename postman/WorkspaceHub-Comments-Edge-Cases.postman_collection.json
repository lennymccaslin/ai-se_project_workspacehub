        },
        {
          "name": "Delete with malformed comment ID",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/not-an-object-id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete rejects a malformed comment ID with 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get nonexistent comment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments/000000000000000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A well-formed but nonexistent comment returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a comment through the wrong task",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{otherTaskId}}/comments/{{commentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A comment cannot be retrieved under a different task', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch a comment through the wrong task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{otherTaskId}}/comments/{{commentId}}",
            "body": { "mode": "raw", "raw": "{\"content\":\"wrong task\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A comment cannot be updated under a different task', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a comment through the wrong task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{otherTaskId}}/comments/{{commentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A comment cannot be deleted under a different task', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Invalid content and request bodies",
      "item": [
        {
          "name": "Create with missing content",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
