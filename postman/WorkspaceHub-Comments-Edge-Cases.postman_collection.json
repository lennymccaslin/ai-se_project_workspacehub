{
  "info": {
    "name": "WorkspaceHub - Comments API edge cases",
    "description": "Run the entire collection in order against a seeded, disposable WorkspaceHub database. Defaults use the seeded owner account. Setup selects two existing tasks and creates one temporary comment; the final request deletes it. Failures may leave that comment behind. Tests deliberately send invalid requests and assert the desired client-error behavior, not permission rules. A 1000-character limit is measured in JavaScript UTF-16 code units after trimming.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api" },
    { "key": "email", "value": "owner@workspacehub.dev" },
    { "key": "password", "value": "Password123!" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "organizationId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "otherTaskId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "content1000", "value": "" },
    { "key": "content1001", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('content1000', 'x'.repeat(1000));",
          "pm.variables.set('content1001', 'x'.repeat(1001));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Log in as seeded owner",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds and returns a token and user', () => { pm.response.to.have.status(200); const d = pm.response.json().data; pm.expect(d.token).to.be.a('string').and.not.empty; pm.expect(d.user._id).to.be.a('string'); pm.expect(d.user.organizationId).to.be.a('string'); });",
                  "if (pm.response.code === 200) { const d = pm.response.json().data; pm.collectionVariables.set('token', d.token); pm.collectionVariables.set('userId', d.user._id); pm.collectionVariables.set('organizationId', d.user.organizationId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Find two distinct existing tasks",
          "request": { "method": "GET", "url": "{{baseUrl}}/tasks" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Task list contains at least two tasks', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array').with.lengthOf.at.least(2); });",
                  "if (pm.response.code === 200) { const tasks = pm.response.json().data; if (tasks.length >= 2) { pm.collectionVariables.set('taskId', tasks[0]._id); pm.collectionVariables.set('otherTaskId', tasks[1]._id); } }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a control comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"edge-case control\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Control comment is created', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().data._id).to.be.a('string'); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('commentId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
