            "body": { "mode": "raw", "raw": "{\"content\":\"test\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Patch rejects a malformed comment ID with 400', () => pm.response.to.have.status(400));"
                ]
              }
