              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing content returns a 400 error envelope', () => { pm.response.to.have.status(400); const r = pm.response.json(); pm.expect(r.success).to.eql(false); pm.expect(r.data).to.eql(null); pm.expect(r.error.message).to.be.a('string'); });"
                ]
